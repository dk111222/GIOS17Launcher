<?xml version="1.0" encoding="utf-8"?>
<com.cloudx.ios17.core.customviews.BlurLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:blurCornerRadius="100dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widgets_search_bar_bg"
        android:focusableInTouchMode="true"
        android:padding="8dp">

        <com.cloudx.ios17.core.customviews.BlissInput
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/clearSuggestionImageView"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/ic_search_black_24dp"
            android:drawablePadding="8dp"
            android:hint="@string/search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textColorHint="@color/widgets_search_hint"
            android:theme="?searchBarTheme" />

        <ImageView
            android:id="@+id/clearSuggestionImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_cancel_white_24dp"
            android:visibility="gone" />
    </RelativeLayout>
</com.cloudx.ios17.core.customviews.BlurLayout>
