<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#DCEBF6" />
            <corners android:radius="@dimen/gree_card_radius" />
        </shape>
    </item>

    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/bg_weather" />
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#85FFFFFF"
                android:endColor="#1AFFFFFF"
                android:startColor="#DBFFFFFF" />
            <corners android:radius="@dimen/gree_card_radius" />
        </shape>
    </item>
</layer-list>
