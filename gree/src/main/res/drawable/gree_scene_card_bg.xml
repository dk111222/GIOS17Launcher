<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gree_neo_pill_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/gree_neo_accent" />
            <corners android:radius="@dimen/gree_scene_card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gree_neo_card" />
            <stroke
                android:width="1dp"
                android:color="@color/gree_neo_card_border" />
            <corners android:radius="@dimen/gree_scene_card_radius" />
        </shape>
    </item>
</selector>
