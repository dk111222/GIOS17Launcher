<?xml version="1.0" encoding="utf-8"?>
<!-- Tall-card layout for sw >= 480: title top, status block bottom -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/gree_plus_dev_height"
    android:background="@drawable/gree_plus_dev_bg"
    android:clickable="true"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/dev_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/gree_plus_dev_image_margin_end"
        android:layout_marginBottom="@dimen/gree_plus_dev_image_margin_bottom"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitEnd" />

    <LinearLayout
        android:id="@+id/gree_plus_dev_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/gree_plus_dev_content_padding_start"
        android:paddingTop="@dimen/gree_plus_dev_content_padding_top"
        android:paddingEnd="@dimen/gree_plus_dev_content_padding_end"
        android:paddingBottom="@dimen/gree_plus_dev_content_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dev_agg"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_gree_plus_agg"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dev_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/gree_neo_ink"
                android:textSize="@dimen/gree_plus_dev_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dev_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/gree_plus_room_chip"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="@dimen/gree_plus_dev_room_padding_h"
                android:paddingTop="@dimen/gree_plus_dev_room_padding_v"
                android:paddingEnd="@dimen/gree_plus_dev_room_padding_h"
                android:paddingBottom="@dimen/gree_plus_dev_room_padding_v"
                android:singleLine="true"
                android:textColor="@color/gree_neo_ink3"
                android:textSize="@dimen/gree_plus_dev_room_size" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/dev_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/gree_neo_ink"
            android:textSize="@dimen/gree_plus_dev_value_size" />

        <TextView
            android:id="@+id/dev_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gree_plus_dev_sub_margin_top"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/gree_neo_ink3"
            android:textSize="@dimen/gree_plus_dev_sub_size" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/dev_bar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="@dimen/gree_plus_dev_bar_margin_end"
        android:layout_marginBottom="@dimen/gree_plus_dev_bar_margin_bottom"
        android:background="@drawable/gree_plus_bar_track"
        android:visibility="gone">

        <View
            android:id="@+id/dev_bar_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/gree_plus_bar_wash" />
    </FrameLayout>
</FrameLayout>
