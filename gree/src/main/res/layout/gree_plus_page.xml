<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/gree_plus_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/gree_plus_scroll_padding_bottom"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/gree_plus_page_h_padding"
            android:paddingEnd="@dimen/gree_plus_page_h_padding">

            <!-- Hero clock -->
            <LinearLayout
                android:id="@+id/gree_plus_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingTop="@dimen/gree_plus_hero_padding_top"
                android:paddingEnd="4dp"
                android:paddingBottom="@dimen/gree_plus_hero_padding_bottom">

                <TextView
                    android:id="@+id/gree_plus_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:shadowColor="#6B2E2212"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="12"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/gree_plus_time_size" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/gree_plus_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.05"
                        android:shadowColor="#802E2212"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="8"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/gree_plus_meta_size"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_gree_plus_cloud" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.05"
                        android:shadowColor="#802E2212"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="8"
                        android:text="@string/gree_plus_weather"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/gree_plus_meta_size"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Home overview -->
            <LinearLayout
                android:id="@+id/gree_plus_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gree_plus_home_margin_top"
                android:background="@drawable/gree_plus_env_bg"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="@dimen/gree_plus_home_padding_h"
                android:paddingTop="@dimen/gree_plus_home_padding_v"
                android:paddingEnd="@dimen/gree_plus_home_padding_h"
                android:paddingBottom="@dimen/gree_plus_home_padding_v">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/gree_plus_glyph_oval"
                        android:backgroundTint="@color/gree_plus_glyph_green">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_gree_plus_leaf" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:includeFontPadding="false"
                        android:text="@string/gree_plus_home_title"
                        android:textColor="@color/gree_neo_ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/gree_plus_home_go"
                        android:textColor="#A09A89"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginBottom="3dp"
                            android:background="@drawable/gree_plus_glyph_oval"
                            android:backgroundTint="@color/gree_plus_glyph_green">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_gree_plus_air" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/gree_plus_metric_air"
                            android:textColor="@color/gree_neo_ink3"
                            android:textSize="9sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:includeFontPadding="false"
                            android:text="@string/gree_plus_air_value"
                            android:textColor="@color/gree_plus_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/gree_plus_env_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginBottom="3dp"
                            android:background="@drawable/gree_plus_glyph_oval"
                            android:backgroundTint="@color/gree_plus_glyph_orange">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_gree_plus_temp" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/gree_plus_metric_temp"
                            android:textColor="@color/gree_neo_ink3"
                            android:textSize="9sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:includeFontPadding="false"
                            android:text="@string/gree_plus_temp_value"
                            android:textColor="@color/gree_plus_orange"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/gree_plus_env_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginBottom="3dp"
                            android:background="@drawable/gree_plus_glyph_oval"
                            android:backgroundTint="@color/gree_plus_glyph_blue">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_gree_plus_drop" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/gree_plus_metric_humid"
                            android:textColor="@color/gree_neo_ink3"
                            android:textSize="9sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:includeFontPadding="false"
                            android:text="@string/gree_plus_humid_value"
                            android:textColor="@color/gree_plus_blue"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/gree_plus_env_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginBottom="3dp"
                            android:background="@drawable/gree_plus_glyph_oval"
                            android:backgroundTint="@color/gree_plus_glyph_orange">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_gree_plus_zap" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/gree_plus_metric_power"
                            android:textColor="@color/gree_neo_ink3"
                            android:textSize="9sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/gree_plus_power_value"
                                android:textColor="@color/gree_plus_orange"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="1dp"
                                android:includeFontPadding="false"
                                android:text="@string/gree_plus_power_unit"
                                android:textColor="@color/gree_plus_orange"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/gree_plus_env_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginBottom="3dp"
                            android:background="@drawable/gree_plus_glyph_oval"
                            android:backgroundTint="@color/gree_plus_glyph_green">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_gree_plus_shield" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/gree_plus_metric_safe"
                            android:textColor="@color/gree_neo_ink3"
                            android:textSize="9sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:includeFontPadding="false"
                            android:text="@string/gree_plus_safe_value"
                            android:textColor="@color/gree_plus_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Section: devices -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gree_plus_section_devices_margin_top"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="@string/gree_plus_section_devices"
                    android:textColor="@color/gree_plus_sec_title"
                    android:textSize="@dimen/gree_plus_section_title_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gree_plus_section_running"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="@string/gree_plus_section_running"
                    android:textColor="@color/gree_plus_sec_em"
                    android:textSize="@dimen/gree_plus_section_running_size"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/gree_plus_all_spaces"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gree_plus_sec_btn"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/gree_plus_all_spaces"
                    android:textColor="@color/gree_neo_accent_dark"
                    android:textSize="@dimen/gree_plus_section_btn_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gree_plus_all_devices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/gree_plus_sec_btn"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/gree_plus_all_devices"
                    android:textColor="@color/gree_neo_accent_dark"
                    android:textSize="@dimen/gree_plus_section_btn_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gree_plus_dev_grid_v_gap"
                android:orientation="horizontal">

                <include
                    android:id="@+id/gree_plus_ac_card"
                    layout="@layout/item_gree_plus_device"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gree_plus_dev_height"
                    android:layout_marginEnd="@dimen/gree_plus_dev_grid_h_gap"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gree_plus_fridge_card"
                    layout="@layout/item_gree_plus_device"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gree_plus_dev_height"
                    android:layout_marginStart="@dimen/gree_plus_dev_grid_h_gap"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gree_plus_dev_grid_v_gap"
                android:orientation="horizontal">

                <include
                    android:id="@+id/gree_plus_washer_card"
                    layout="@layout/item_gree_plus_device"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gree_plus_dev_height"
                    android:layout_marginEnd="@dimen/gree_plus_dev_grid_h_gap"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gree_plus_rice_card"
                    layout="@layout/item_gree_plus_device"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gree_plus_dev_height"
                    android:layout_marginStart="@dimen/gree_plus_dev_grid_h_gap"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Duo cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gree_plus_duo_margin_top"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/gree_plus_mall"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gree_plus_dev_height"
                    android:layout_marginEnd="@dimen/gree_plus_duo_h_gap"
                    android:layout_weight="1"
                    android:background="@drawable/gree_plus_duo_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/gree_plus_duo_padding_start"
                    android:paddingTop="@dimen/gree_plus_duo_padding_top"
                    android:paddingEnd="@dimen/gree_plus_duo_padding_end"
                    android:paddingBottom="@dimen/gree_plus_duo_padding_bottom">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_gree_plus_chevron"
                        android:drawableTint="#C8C2B1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:letterSpacing="0.12"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/gree_plus_mall_title"
                        android:textColor="@color/gree_neo_ink3"
                        android:textSize="@dimen/gree_plus_duo_header_size"
                        android:textStyle="bold" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/gree_plus_mall_pager"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/gree_plus_mall_pager_margin_top" />

                    <LinearLayout
                        android:id="@+id/gree_plus_mall_dots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:orientation="horizontal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/gree_plus_tonight"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gree_plus_dev_height"
                    android:layout_marginStart="@dimen/gree_plus_duo_h_gap"
                    android:layout_weight="1"
                    android:background="@drawable/gree_plus_duo_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/gree_plus_duo_padding_start"
                    android:paddingTop="@dimen/gree_plus_duo_padding_top"
                    android:paddingEnd="@dimen/gree_plus_duo_padding_end"
                    android:paddingBottom="@dimen/gree_plus_duo_padding_bottom">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_gree_plus_chevron"
                        android:drawableTint="#C8C2B1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:letterSpacing="0.12"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/gree_plus_tonight_title"
                        android:textColor="@color/gree_neo_ink3"
                        android:textSize="@dimen/gree_plus_duo_header_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gree_plus_tonight_primary_margin_top"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/gree_plus_tonight_primary"
                        android:textColor="@color/gree_neo_ink"
                        android:textSize="@dimen/gree_plus_tonight_primary_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gree_plus_tonight_sub_margin_top"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/gree_plus_tonight_sub"
                        android:textColor="@color/gree_neo_ink3"
                        android:textSize="@dimen/gree_plus_tonight_sub_size" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
