<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gree_all_devices_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gree_neo_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/gree_plus_page_h_padding"
        android:paddingEnd="@dimen/gree_plus_page_h_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/gree_all_devices_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/gree_all_devices_back"
                android:padding="10dp"
                android:src="@drawable/ic_gree_scan_back" />

            <TextView
                android:id="@+id/gree_all_devices_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/gree_room_all"
                android:textColor="@color/gree_neo_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gree_all_devices_extra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gree_neo_ink3"
                android:textSize="12sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/gree_all_devices_room_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gree_all_devices_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/gree_all_devices_scene_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gree_neo_card"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gree_neo_card_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gree_scene_quick_footer_padding_h"
            android:paddingTop="@dimen/gree_scene_quick_footer_padding_top"
            android:paddingEnd="@dimen/gree_scene_quick_footer_padding_h"
            android:paddingBottom="@dimen/gree_scene_quick_footer_padding_bottom">

            <TextView
                android:id="@+id/gree_all_devices_scene_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="@dimen/gree_scene_quick_title_margin_bottom"
                android:text="@string/gree_all_devices_scene_quick_title"
                android:textColor="@color/gree_neo_ink3"
                android:textSize="@dimen/gree_scene_quick_title_size"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/gree_scene_quick_btn_height"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/gree_all_devices_scene_row"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
