<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/mall_image"
        android:layout_width="@dimen/gree_plus_mall_image_size"
        android:layout_height="@dimen/gree_plus_mall_image_size"
        android:background="@color/gree_plus_chip_bg"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/gree_plus_mall_text_gap"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mall_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/gree_neo_ink"
            android:textSize="@dimen/gree_plus_mall_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mall_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gree_plus_dev_sub_margin_top"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/gree_neo_ink3"
            android:textSize="@dimen/gree_plus_mall_desc_size" />
    </LinearLayout>
</LinearLayout>
