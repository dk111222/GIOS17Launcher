    <string name="gree_profile_loc_dad">家中 · 明珠花园 3 栋</string>
    <string name="gree_profile_loc_mom">公司 · 格力科技园（围栏外 2.3km）</string>
    <string name="gree_profile_loc_grandpa">小区花园 · 散步中（围栏内）</string>
    <string name="gree_profile_loc_girl">学校 · 实验小学（围栏内）</string>
    <string name="gree_profile_diet_dad">健身管理期：推荐西兰花、鸡胸肉等高蛋白低脂食材，晚餐七分饱。</string>
    <string name="gree_profile_diet_mom">补钙养颜：推荐鲈鱼、嫩豆腐，注意补充胶原蛋白与维生素 C。</string>
    <string name="gree_profile_diet_grandpa">低盐低脂、软烂易消化：推荐鸡蛋羹、菠菜，注意补铁护心。</string>
    <string name="gree_profile_diet_girl">成长发育期：推荐鲜牛奶、红富士苹果，少食多餐、少零食。</string>
    <string name="gree_profile_water_dad">运动后 30 分钟内补水约 300mL，少喝碳酸饮料。</string>
    <string name="gree_profile_water_mom">晨起一杯 45°C 温水；午后减少咖啡，避免影响睡眠。</string>
    <string name="gree_profile_water_grandpa">少量多次，睡前 1 小时避免大量饮水；用药期间遵医嘱饮水。</string>
    <string name="gree_profile_water_girl">避免冰水，课间定时提醒喝水，每日不少于 1.2L。</string>

