<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>格力智慧家庭 · Android 概念 Demo</title>
<style>
:root{
  --blue:#1a73e8; --blue-d:#1557b0; --ink:#17181c; --ink2:#5f6368; --ink3:#9aa0a6;
  --bg:#f2f3f5; --card:#ffffff; --line:#e8eaed;
  --green:#34a853; --orange:#f29900; --red:#e54545; --teal:#00b8a9; --purple:#7c4dff;
  --pw:400px; --ph:848px;
  --font:-apple-system,"PingFang SC","HarmonyOS Sans SC","Microsoft YaHei","Noto Sans SC",sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:var(--font);background:#141519;color:#e8eaed;overflow:hidden;user-select:none}
button{font-family:var(--font);border:none;background:none;cursor:pointer;color:inherit}
input{font-family:var(--font);border:none;outline:none;background:none}
::-webkit-scrollbar{width:0;height:0}

/* ============ 外层舞台 ============ */
.stage{height:100%;display:flex;align-items:center;justify-content:center;gap:44px;
  background:radial-gradient(1200px 700px at 70% 20%,#20242e 0%,#141519 60%)}
.side-tools{display:flex;flex-direction:column;gap:12px;width:200px}
.side-tools .st-title{font-size:13px;color:#9aa0a6;letter-spacing:.12em;margin-bottom:6px}
.tool-btn{display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:12px;
  background:#22252d;border:1px solid #30343e;color:#dfe3ea;font-size:13px;text-align:left;transition:.18s}
.tool-btn:hover{background:#2b2f3a;border-color:#3d4350}
.tool-btn svg{flex:0 0 auto}
.tool-hint{font-size:11px;color:#6b7078;line-height:1.8;margin-top:8px}

/* ============ 手机框 ============ */
.phone-shell{position:relative;padding:14px;border-radius:56px;
  background:linear-gradient(160deg,#3a3d45,#101115 40%,#2a2d34);
  box-shadow:0 40px 80px rgba(0,0,0,.55),0 0 0 2px #06070a,inset 0 0 0 2px rgba(255,255,255,.06);
  transition:opacity .35s,box-shadow .35s}
.phone-shell .side-key{position:absolute;right:-4px;top:150px;width:5px;height:72px;border-radius:2px;background:#3c4048;transition:opacity .3s,background .2s;cursor:pointer}
.phone-shell .side-key.vol{right:auto;left:-3px;top:130px;height:46px}
.phone-shell .side-key.vol2{right:auto;left:-3px;top:186px;height:46px}
.phone-shell.frame-off{background:transparent;box-shadow:none}
.phone-shell.frame-off .side-key{opacity:0}
.screen{position:relative;width:var(--pw);height:var(--ph);border-radius:42px;overflow:hidden;background:#000}
.punch{position:absolute;top:12px;left:50%;transform:translateX(-50%);width:14px;height:14px;border-radius:50%;
  background:#000;box-shadow:inset 0 0 3px 1px #1a1c22;z-index:400;pointer-events:none}

/* ============ 状态栏 ============ */
.statusbar{position:absolute;top:0;left:0;right:0;height:34px;z-index:300;display:flex;align-items:center;
  justify-content:space-between;padding:4px 26px 0;font-size:13.5px;font-weight:600;cursor:grab}
.statusbar .sb-right{display:flex;align-items:center;gap:6px}
.statusbar.sb-light{color:#fff}
.statusbar.sb-dark{color:var(--ink)}
.sb-batt{width:24px;height:12px;border:1.6px solid currentColor;border-radius:3.5px;position:relative;opacity:.9}
.sb-batt::after{content:"";position:absolute;right:-4px;top:2.6px;width:2.4px;height:5px;border-radius:0 2px 2px 0;background:currentColor}
.sb-batt i{position:absolute;left:1.6px;top:1.6px;bottom:1.6px;width:65%;background:currentColor;border-radius:1.5px}

/* ============ 导航栏 ============ */
.navbar{position:absolute;left:0;right:0;bottom:0;height:48px;z-index:300;display:flex;align-items:center;justify-content:space-around}
.navbar.nb-dark{background:rgba(0,0,0,.28);backdrop-filter:blur(18px);color:#fff}
.navbar.nb-light{background:rgba(242,243,245,.86);backdrop-filter:blur(18px);color:#1b1c1f}
.navbar button{width:72px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:12px;opacity:.92}
.navbar button:active{background:rgba(128,128,128,.22)}

/* ============ 页面层 ============ */
.viewport{position:absolute;inset:0;overflow:hidden}
.page{position:absolute;inset:0;overflow:hidden;display:flex;flex-direction:column}
.page-scroll{flex:1;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
.stack-page{position:absolute;inset:0;z-index:120;background:var(--bg);color:var(--ink);display:flex;flex-direction:column;
  transform:translateX(100%);transition:transform .34s cubic-bezier(.32,.72,.28,1);box-shadow:-12px 0 32px rgba(0,0,0,.25)}
.stack-page.in{transform:translateX(0)}
.stack-page.out{transform:translateX(100%)}
.pg-head{flex:0 0 auto;display:flex;align-items:center;gap:10px;padding:44px 14px 10px;background:var(--bg)}
.pg-head .pg-back{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--ink)}
.pg-head .pg-back:active{background:rgba(0,0,0,.06)}
.pg-head h1{font-size:17px;font-weight:600;color:var(--ink);flex:1}
.pg-head .pg-extra{font-size:12px;color:var(--ink2)}

/* ============ 桌面 Launcher ============ */
.launcher{background:linear-gradient(165deg,#2b3a67 0%,#1b2547 34%,#0e1330 62%,#1a1033 100%);color:#fff}
.launcher::before{content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(420px 300px at 80% 12%,rgba(124,77,255,.35),transparent 70%),
             radial-gradient(500px 380px at 12% 45%,rgba(26,115,232,.30),transparent 70%),
             radial-gradient(360px 300px at 70% 82%,rgba(0,184,169,.20),transparent 70%)}
.ln-inner{position:relative;flex:1;display:flex;flex-direction:column;padding:52px 18px 8px}
.clock-widget{text-align:left;margin:6px 6px 14px}
.clock-widget .cw-time{font-size:56px;font-weight:300;letter-spacing:.01em;line-height:1}
.clock-widget .cw-date{font-size:13px;color:rgba(255,255,255,.78);margin-top:6px}
.clock-widget .cw-weather{font-size:12.5px;color:rgba(255,255,255,.62);margin-top:3px}
.dev-widget{margin:0 4px 16px;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.14);
  backdrop-filter:blur(14px);border-radius:20px;padding:13px 16px;display:flex;align-items:center;gap:14px;min-height:82px}
.dev-widget .dw-ic{width:46px;height:46px;border-radius:14px;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.dev-widget .dw-name{font-size:13.5px;font-weight:600}
.dev-widget .dw-sub{font-size:11.5px;color:rgba(255,255,255,.66);margin-top:3px}
.dev-widget .dw-time{margin-left:auto;text-align:right}
.dev-widget .dw-time b{font-size:22px;font-weight:600;font-variant-numeric:tabular-nums}
.dev-widget .dw-time span{display:block;font-size:10.5px;color:rgba(255,255,255,.6);margin-top:2px}
.dw-dots{display:flex;justify-content:center;gap:6px;margin:-8px 0 14px}
.dw-dots i{width:5px;height:5px;border-radius:99px;background:rgba(255,255,255,.35);transition:all .3s;cursor:pointer}
.dw-dots i.on{width:15px;background:rgba(255,255,255,.92)}
.life-widget{margin:2px 2px 16px;overflow:hidden;
  background:radial-gradient(130% 120% at 6% 0%,rgba(122,162,255,.52),rgba(122,162,255,0) 56%),
    radial-gradient(130% 130% at 102% 12%,rgba(178,128,250,.46),rgba(178,128,250,0) 58%),
    radial-gradient(150% 130% at 52% 118%,rgba(70,200,228,.42),rgba(70,200,228,0) 60%),
    rgba(22,28,52,.30);
  border:1px solid rgba(255,255,255,.38);
  backdrop-filter:blur(24px) saturate(1.35);-webkit-backdrop-filter:blur(24px) saturate(1.35);
  border-radius:24px;padding:14px;color:#fff;text-shadow:0 1px 4px rgba(10,14,32,.30);box-shadow:0 16px 36px rgba(8,12,30,.34)}
.lw-h{display:flex;align-items:center;margin:0 3px 10px}
.lw-t{font-size:15.5px;font-weight:700;letter-spacing:.02em;color:#fff}
.lw-more{margin-left:auto;font-size:12px;color:rgba(255,255,255,.80);display:flex;align-items:center;gap:4px;padding:4px 2px}
.lw-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;min-width:0}
.lw-cell{position:relative;min-width:0;min-height:182px;border-radius:18px;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.24);color:#fff;padding:11px 6px;overflow:hidden;cursor:pointer;display:flex;flex-direction:column}
.lw-cell:active{transform:scale(.97)}
.lw-cell h4{font-size:13px;font-weight:700;color:#fff;min-width:0}
.lw-cell>p{font-size:12px;color:rgba(255,255,255,.74);margin-top:2px;line-height:1.25;white-space:nowrap}
.lw-img{display:block;width:100%;max-width:100%;min-width:0;height:70px;object-fit:contain;margin:7px 0 6px;filter:drop-shadow(0 7px 9px rgba(20,25,40,.16))}
.lw-img.tall{height:80px;margin:5px 0 6px}
.lw-cell.other .lw-img{height:80px;margin:5px 0 6px}
.lw-st{font-size:12px;color:rgba(255,255,255,.74);line-height:1.3;margin-top:auto}
.lw-num{display:flex;align-items:center;gap:4px;min-width:0}
.lw-num b{font-size:16px;color:#fff;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums;white-space:nowrap}
.lw-num svg{flex:0 0 auto;margin-top:2px;width:14px;height:14px}
.lw-st small{display:block;font-size:12px;color:rgba(255,255,255,.72);margin-top:3px;white-space:nowrap}
.lw-duo{display:flex;gap:6px;margin-top:auto;min-width:0}
.lw-duo b{display:block;font-size:13.5px;color:#191c22;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums;white-space:nowrap}
.lw-duo small{display:block;font-size:9px;color:rgba(52,56,66,.68);margin-top:2px;white-space:nowrap}
.lw-time{font-size:16px!important;color:#fff;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums;white-space:nowrap}
.lw-cell.other{background:rgba(255,255,255,.09)}
#lwAc{background:linear-gradient(160deg,rgba(96,160,255,.34),rgba(255,255,255,.08))}
#lwAc .lw-img{height:96px;margin:2px 0 3px;filter:drop-shadow(0 8px 11px rgba(20,25,40,.30))}
.lw-go{position:absolute;right:8px;bottom:10px;width:23px;height:23px;border-radius:50%;background:rgba(255,255,255,.95);color:#5f6368;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 7px rgba(0,0,0,.14)}
.lwx-mask{position:absolute;inset:0;z-index:600;background:rgba(16,20,36,.30);backdrop-filter:blur(16px) saturate(1.2);-webkit-backdrop-filter:blur(16px) saturate(1.2);opacity:0;transition:opacity .36s}
.lwx-mask.show{opacity:1}
.lwx-panel{position:absolute;z-index:601;margin:0;display:flex;flex-direction:column;overflow:hidden;
  transition:left .44s cubic-bezier(.32,.72,.24,1),top .44s cubic-bezier(.32,.72,.24,1),width .44s cubic-bezier(.32,.72,.24,1),height .44s cubic-bezier(.32,.72,.24,1)}
.lwx-panel .lw-h{flex:0 0 auto}
.lwx-gridview{flex:0 0 auto;max-height:230px;overflow:hidden;pointer-events:none;transition:opacity .24s,transform .4s,max-height .4s .04s}
.lwx-panel.on .lwx-gridview{opacity:0;transform:scale(.9);max-height:0}
.lwx-listview{flex:1;min-height:0;overflow-y:auto;opacity:0;transform:translateY(16px);transition:opacity .3s .16s,transform .4s .16s}
.lwx-panel.on .lwx-listview{opacity:1;transform:none}
.lwx-row{display:flex;align-items:center;gap:11px;padding:9px 2px;border-bottom:1px solid rgba(255,255,255,.13);cursor:pointer;opacity:0;transform:translateY(12px);transition:opacity .3s,transform .36s}
.lwx-panel.on .lwx-row{opacity:1;transform:none}
.lwx-row:last-child{border-bottom:none}
.lwx-row .lx-ic{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;flex:0 0 auto;box-shadow:0 2px 6px rgba(10,14,30,.25)}
.lwx-row .lx-ic svg{width:16px;height:16px}
.lwx-row h5{font-size:12.5px;font-weight:600;color:#fff}
.lwx-row p{font-size:10.5px;color:rgba(255,255,255,.64);margin-top:1px}
.lwx-row .lx-st{margin-left:auto;font-size:11px;font-weight:700;display:flex;align-items:center;gap:5px;color:rgba(255,255,255,.75)}
.life-expand .le-h{display:flex;align-items:center;margin-bottom:8px}
.life-expand h3{font-size:16px;font-weight:700;color:var(--ink)}
.life-expand .le-n{margin-left:auto;font-size:11px;color:var(--ink3)}
.life-expand .le-x{margin-left:8px;width:26px;height:26px;border-radius:50%;color:var(--ink3);display:flex;align-items:center;justify-content:center;font-size:14px}
.life-list{max-height:56vh;overflow-y:auto;padding-right:2px;-webkit-overflow-scrolling:touch}
.life-row{display:flex;align-items:center;gap:11px;padding:10px 2px;border-bottom:1px solid #f1f2f4;cursor:pointer}
.life-row:last-child{border-bottom:none}
.life-row .lr-ic{width:38px;height:38px;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;flex:0 0 auto}
.life-row h5{font-size:13px;font-weight:700;color:var(--ink)}
.life-row p{font-size:10.5px;color:var(--ink3);margin-top:2px}
.life-row .lr-st{margin-left:auto;font-size:12px;color:var(--ink3);text-align:right}
.life-row .lr-st b{display:block;font-size:10.5px;margin-bottom:2px}
.app-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px 8px;padding:0 4px}
.app{display:flex;flex-direction:column;align-items:center;gap:6px}
.app .ic{width:52px;height:52px;border-radius:15px;display:flex;align-items:center;justify-content:center;
  box-shadow:0 4px 12px rgba(0,0,0,.28);transition:transform .12s}
.app:active .ic{transform:scale(.88)}
.app span{font-size:11px;color:rgba(255,255,255,.9)}
.ln-dots{display:flex;justify-content:center;gap:6px;margin:auto 0 8px}
.ln-dots i{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.35)}
.ln-dots i.on{background:#fff}
.dock{margin:0 2px 4px;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.12);
  backdrop-filter:blur(16px);border-radius:24px;padding:10px 8px;display:grid;grid-template-columns:repeat(5,1fr)}
.dock .app .ic{width:48px;height:48px;box-shadow:none}

/* ============ 通用组件 ============ */
.toast{position:absolute;left:50%;bottom:34px;transform:translateX(-50%) translateY(10px);z-index:600;
  background:rgba(24,25,28,.92);color:#fff;font-size:12.5px;padding:9px 18px;border-radius:20px;
  opacity:0;pointer-events:none;transition:.25s;max-width:82%;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.mask{position:absolute;inset:0;z-index:500;background:rgba(30,32,38,.38);
  backdrop-filter:blur(14px) saturate(1.15);-webkit-backdrop-filter:blur(14px) saturate(1.15);
  display:flex;align-items:flex-end;opacity:0;pointer-events:none;transition:opacity .28s}
.mask.show{opacity:1;pointer-events:auto}
.mask.center{align-items:center;justify-content:center}
.sheet{width:100%;max-height:76%;background:#fff;border-radius:26px 26px 0 0;padding:20px 18px 26px;
  transform:translateY(100%);transition:transform .32s cubic-bezier(.32,.72,.28,1);overflow-y:auto;color:var(--ink)}
.mask.show .sheet{transform:translateY(0)}
.dialog{width:86%;max-height:80%;background:#fff;border-radius:24px;padding:20px 18px;overflow-y:auto;
  transform:scale(.9) translateY(14px);opacity:0;transition:.28s cubic-bezier(.32,.72,.28,1);color:var(--ink)}
.mask.show .dialog{transform:scale(1) translateY(0);opacity:1}
.grab{width:38px;height:4px;border-radius:2px;background:#dadce0;margin:0 auto 14px}
</style>
<style>
/* ============ 负一屏 · 格力 ============ */
.gree{background:var(--bg);color:var(--ink);transform:translateX(-100%);transition:transform .34s cubic-bezier(.32,.72,.28,1)}
.gree.on{transform:translateX(0)}
.launcher.off{transform:translateX(100%)}
.launcher{transition:transform .34s cubic-bezier(.32,.72,.28,1)}
.g-head{flex:0 0 auto;display:flex;align-items:center;gap:14px;padding:46px 16px 10px}
.g-avatar{width:38px;height:38px;border-radius:50%;object-fit:cover;box-shadow:0 2px 8px rgba(0,0,0,.14);cursor:pointer}
.g-tabs{flex:1;display:flex;justify-content:center;gap:6px;background:#e7e9ee;border-radius:20px;padding:4px}
.g-tab{position:relative;font-size:13.5px;color:var(--ink2);padding:6px 16px;border-radius:16px;font-weight:500}
.g-tab.on{background:#fff;color:var(--ink);font-weight:600;box-shadow:0 2px 6px rgba(0,0,0,.08)}
.g-tab .dot{position:absolute;top:4px;right:8px;width:7px;height:7px;border-radius:50%;background:var(--red)}
.g-home{display:inline-flex;align-items:center;gap:6px;margin:0 0 8px 2px;background:#fff;border-radius:99px;padding:6px 13px;font-size:11.5px;font-weight:600;color:var(--ink);box-shadow:0 2px 8px rgba(20,25,40,.06);cursor:pointer;width:fit-content}
.v2-hero{margin:4px 0 14px;border-radius:24px;padding:22px 20px 18px;background:linear-gradient(135deg,#0f4c9c,#1a73e8 60%,#00b8a9);color:#fff;cursor:pointer;box-shadow:0 8px 22px rgba(15,76,156,.25)}
.v2-hero-tag{font-size:12px;opacity:.85}
.v2-hero-n{font-size:44px;font-weight:800;line-height:1.05;margin-top:2px}
.v2-hero-n span{font-size:15px;font-weight:600;margin-left:4px;opacity:.9}
.v2-hero-hl{font-size:17px;font-weight:700;line-height:1.5;margin-top:12px}
.v2-hero-sub{font-size:11px;opacity:.82;margin-top:8px;line-height:1.7}
.v2-hero-go{display:inline-flex;align-items:center;gap:3px;font-size:11.5px;font-weight:600;margin-top:12px;background:rgba(255,255,255,.16);border-radius:99px;padding:6px 12px;width:fit-content}
.v2-todo{display:flex;align-items:center;gap:12px;background:#fff;border-radius:20px;padding:14px 16px;margin-bottom:14px;box-shadow:0 2px 10px rgba(20,25,40,.05)}
.v2-todo>div{flex:1;min-width:0}
.v2-todo-badge{display:inline-block;font-size:10px;font-weight:700;color:#e54545;background:#fdeeee;border-radius:99px;padding:4px 9px}
.v2-todo p{font-size:12.5px;color:var(--ink);line-height:1.6;margin-top:7px}
.v2-todo-btn{flex:0 0 auto;background:var(--blue);color:#fff;font-size:12.5px;font-weight:700;border-radius:16px;padding:10px 20px}
/* ---- V3 房间维度 ---- */
.v3-room{border-radius:20px;padding:13px 16px 12px;margin-bottom:10px;cursor:pointer}
.v3-room .r3-h{display:flex;align-items:center;gap:8px;margin-bottom:4px}
.v3-room .r3-ic{display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.v3-room .r3-h h3{font-size:14px;font-weight:700}
.v3-who{font-size:10px;padding:3px 8px;border-radius:9px;font-weight:700}
.v3-who.yes{color:#0d5c34;background:#b9f2cf}
.v3-who.no{color:#5f6368;background:rgba(255,255,255,.72)}
.v3-cells{display:grid;grid-template-columns:repeat(4,1fr)}
.v3-cell{position:relative;padding:4px 0 2px;text-align:center}
.v3-cell+.v3-cell::before{content:'';position:absolute;left:0;top:24%;bottom:24%;width:1px;background:rgba(30,35,50,.08)}
.v3-cell .vrow{display:inline-flex;align-items:center;gap:3px}
.v3-cell b{font-size:15px;font-variant-numeric:tabular-nums}
.v3-cell small{display:block;font-size:9px;color:var(--ink2);margin-top:2px}
.v3-line{margin-top:10px;font-size:11px;color:var(--ink2);display:flex;align-items:center;gap:6px;line-height:1.5}
.v3-line b{color:var(--ink)}
.v3-line svg{flex:0 0 auto}
.v3-fold-t{width:100%;display:flex;align-items:center;justify-content:center;gap:6px;font-size:12px;color:var(--ink2);padding:9px 0 3px;font-weight:600}
.v3-fold{display:none}
.v3-fold.show{display:block}
.v3-mini{display:flex;align-items:center;gap:11px;background:#f7f8fa;border-radius:16px;padding:11px 13px;margin-bottom:8px;cursor:pointer}
.v3-mini .m-ic{width:36px;height:36px;border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:center;flex:0 0 auto;box-shadow:0 1px 4px rgba(20,25,40,.06)}
.v3-mini h5{font-size:13px;font-weight:700}
.v3-mini p{font-size:10.5px;color:var(--ink2);margin-top:2px;line-height:1.45}
