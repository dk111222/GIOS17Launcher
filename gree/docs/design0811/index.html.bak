/* 食材新鲜度统一口径：[文字, 色, 底色]；days<0 为已过期 */
function freshTag(f){
  if(f.days<0)return [`已过期 ${-f.days} 天`,'var(--red)','#fdeaea'];
  if(f.days<=3)return [`剩 ${f.days} 天`,'var(--red)','#fdeaea'];
  if(f.days<=7)return [`剩 ${f.days} 天`,'var(--orange)','#fdf3e3'];
  return ['新鲜','#0d5c34','#e9f9ef'];
}
